<Window x:Class="Incident_Library.WPF_VIEWS.AddLabelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Label"
        Height="160" Width="300" 
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        FontSize="13">

    <StackPanel Margin="16">
        <TextBlock Text="Label name:" Margin="0,0,0,6"/>
        <TextBox x:Name="txtLabelName"
                 Height="26" Padding="4,3"
                 BorderBrush="#7A7A7A" BorderThickness="1"
                 Margin="0,0,0,12"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnOk" Content="OK"
                    Width="70" Height="26" Margin="0,0,8,0"
                    Click="BtnOk_Click"/>
            <Button x:Name="btnCancel" Content="Cancel"
                    Width="70" Height="26"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </StackPanel>
</Window>