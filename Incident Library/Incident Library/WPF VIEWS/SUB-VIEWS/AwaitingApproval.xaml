<Page x:Class="Incident_Library.WPF_VIEWS.SUB_VIEWS.AwaitingApproval"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="White"
      FontFamily="Segoe UI"
      FontSize="13">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Sort dropdown -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="12,8">
            <TextBlock Text="Sort by: " VerticalAlignment="Center" Margin="0,0,6,0"/>
            <ComboBox x:Name="SortDropdown" Width="160"
                      SelectionChanged="SortDropdown_SelectionChanged">
                <ComboBoxItem Content="Newest first"/>
                <ComboBoxItem Content="Oldest first"/>
            </ComboBox>
        </StackPanel>

        <!-- Column headers -->
        <Border Grid.Row="1" Background="#F0F0F0"
                BorderBrush="#ADADAD" BorderThickness="0,0,0,1">
            <Grid Margin="12,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Title" FontWeight="SemiBold" FontSize="12"/>
                <TextBlock Grid.Column="1" Text="WhatIsIncident" FontWeight="SemiBold" FontSize="12"/>
                <TextBlock Grid.Column="2" Text="Date" FontWeight="SemiBold" FontSize="12"/>
                <TextBlock Grid.Column="3" Text="Action" FontWeight="SemiBold" FontSize="12"/>
            </Grid>
        </Border>

        <!-- Incident list -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="IncidentList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" BorderBrush="#DFDFDF"
                                BorderThickness="0,0,0,1" Padding="12,8" Cursor="Hand">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Title}"
                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding WhatIsIncident}"
                                           FontSize="12" Foreground="#555"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding CreatedDate, StringFormat={}{0:dd/MM/yyyy}}"
                                           FontSize="12" Foreground="#555" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="✓"
                                            Tag="{Binding IncidentID}"
                                            Click="BtnApprove_Click"
                                            Width="28" Height="22"
                                            FontSize="12"
                                            Background="#E1E1E1"
                                            BorderBrush="#ADADAD"
                                            BorderThickness="1"
                                            Cursor="Hand"
                                            Margin="0,0,4,0"
                                            ToolTip="Approve"/>
                                    <Button Content="✕"
                                            Tag="{Binding IncidentID}"
                                            Click="BtnReject_Click"
                                            Width="28" Height="22"
                                            FontSize="12"
                                            Background="#E1E1E1"
                                            BorderBrush="#ADADAD"
                                            BorderThickness="1"
                                            Cursor="Hand"
                                            ToolTip="Reject"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Empty state -->
        <TextBlock Grid.Row="2" x:Name="txtEmpty"
                   Text="No incidents awaiting approval."
                   Foreground="#888" FontSize="13"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed"/>
    </Grid>
</Page>